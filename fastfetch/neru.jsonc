{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/imgs/neru.png",
    "type": "auto",
    "height": 18,
    "width": 30,
    "padding": {
      "top": 1,
      "left": 3
    },
  },
  "display": {
    "separator": " : "
  },
  "modules": [
    {
      "type": "custom",
      "format": "Distro Info"
    },
    "break",
    {
      "type": "title",
      "key": "   User",
      "format": "{6}"
    },
    {
      "type": "os",
      "key": "   Distro",
      "format": "{2} {9}",
      "keyColor": "red"
    },
    {
      "type": "kernel",
      "key": "   Kernel",
      "format": "{1} {2}",
      "keyColor": "red"
    },
    {
      "type": "packages",
      "key": "  󰏗 Packages",
      "keyColor": "green"
    },
    {
      "type": "terminal",
      "key": "   Terminal",
      "keyColor": "yellow"
    },
    {
      "type": "shell",
      "key": "   Shell",
      "keyColor": "yellow"
    },
    {
      "type": "de",
      "key": "   Desktop",
      "keyColor": "blue"
    },
    {
      "type": "lm",
      "key": "  ├ Display",
      "keyColor": "blue"
    },
    {
      "type": "wm",
      "key": "  └ Window",
      "keyColor": "blue"
    },
    "break",
    {
      "type": "custom",
      "format": "System Info"
    },
    "break",
    {
      "type": "Host",
      "key": "  󰇺 Host",
      "format": "{1}",
    },
    {
      "type": "cpu",
      "format": "{1} @ {7}",
      "key": "   CPU",
      "keyColor": "blue"
    },
    {
      "type": "gpu",
      "format": "{2} ({3})",
      "key": "  󰍛 GPU",
      "keyColor": "blue"
    },
    {
      "type": "memory",
      "key": "   Memory ",
      "keyColor": "magenta"
    },
    {
      "type": "display",
      "key": "  󰍹 Display",
      "format": "{1}x{2} @ {3}Hz [{7}]",
      "keyColor": "green"
    },
    {
      "type": "disk",
      "key": "  󱦟 OS Age ",
      "folders": "/",
      "keyColor": "red",
      "format": "{days} days"
    },
    {
      "type": "uptime",
      "key": "  󱫐 Uptime ",
      "keyColor": "red"
    },
    "break",
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    },
    "break"
  ]
}
